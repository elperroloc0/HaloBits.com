# --- Local tooling dirs (kept out of the repo) ---
.claude
.halobits
.sidefiles
.vscode

# --- Build output (regenerated by `npm run build`, never commit) ---
dist/
.astro/

# --- Dependencies (restored by `npm install`, can be huge) ---
node_modules/

# --- Secrets & env (NEVER commit these) ---
.env
.env.production

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
.idea/
