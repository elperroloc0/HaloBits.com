---
// Base.astro — HTML shell shared by every page: <head> (SEO, fonts), film grain
// overlay, Nav, <main> (the page's <slot/>), Footer, and the scroll-reveal
// script. Pages pass `current`/`tone`/`flow` through to the Nav (see Nav.astro).
import Nav, { type NavKey } from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { getAlternateUrls, type Lang } from '../i18n/utils';
import { SITE } from '../lib/site';
import { IS_PREVIEW } from '../lib/env';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  current?: NavKey;
  tone?: 'dark' | 'light';
  flow?: boolean;
  /** Background of the page behind <main>; FAQ is cream, everything else dark. */
  theme?: 'dark' | 'light';
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (e.g. FAQPage). */
  schema?: object[];
}
const {
  lang,
  title,
  description = 'HaloBits — not a service, a partner.',
  current,
  tone = 'dark',
  flow = false,
  theme = 'dark',
  noindex = false,
  schema = [],
} = Astro.props;

// Preview deployments are never indexed; production only when the page asks.
const hideFromSearch = noindex || IS_PREVIEW;
// Search Console: paste the token from "HTML tag" verification into PUBLIC_GSC_VERIFICATION.
const gscToken = import.meta.env.PUBLIC_GSC_VERIFICATION;

const alt = getAlternateUrls(Astro.url);
const canonicalURL = new URL(alt[lang], Astro.site);
const enURL = new URL(alt.en, Astro.site);
const esURL = new URL(alt.es, Astro.site);
const ruURL = new URL(alt.ru, Astro.site);
// One share image per language (1200×630) so the WhatsApp/iMessage/LinkedIn
// preview is readable for every visitor: public/og.jpg, og-es.jpg, og-ru.jpg.
const ogImage = new URL({ en: '/og.jpg', es: '/og-es.jpg', ru: '/og-ru.jpg' }[lang], Astro.site);
const ogAlts = {
  en: 'HaloBits — Not a service. A partner.',
  es: 'HaloBits — No es un servicio. Es un socio.',
  ru: 'HaloBits — Не услуга, а партнёр.',
};
const ogAlt = ogAlts[lang];
// Bricolage Grotesque and Geist have no Cyrillic, so Russian pages also load Onest
// (global.css lists it as a fallback). Only /ru/ pays for that extra download.
const fontsHref =
  'https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Geist:wght@300;400;500;600' +
  (lang === 'ru' ? '&family=Onest:wght@500;700;800' : '') +
  '&display=swap';
const ogLocales = { en: 'en_US', es: 'es_US', ru: 'ru_RU' };

// Structured data: tells Google this is a Miami business, how to reach it and
// which languages it works in (feeds the local-search knowledge panel).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.name,
  url: SITE.url,
  logo: new URL('/favicon.svg', Astro.site).toString(),
  image: new URL('/og.jpg', Astro.site).toString(),
  description: description,
  telephone: SITE.phone,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    addressCountry: SITE.country,
  },
  areaServed: { '@type': 'City', name: SITE.city },
  availableLanguage: ['English', 'Spanish', 'Russian'],
  // sameAs: add Google Business Profile / LinkedIn / Instagram URLs here once they exist.
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="ru" href={ruURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {Object.entries(ogLocales).filter(([l]) => l !== lang).map(([, loc]) => <meta property="og:locale:alternate" content={loc} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {hideFromSearch && <meta name="robots" content="noindex, nofollow" />}
    {gscToken && <meta name="google-site-verification" content={gscToken} />}
    {
      [jsonLd, ...schema].map((obj) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
      ))
    }
    <slot name="head" />
    <meta name="theme-color" content={theme === 'light' ? '#EFE6D6' : '#14110F'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fonts load without blocking the first paint (text shows in the fallback font
         and swaps when they arrive). `media=print` → `all` on load is the standard
         non-blocking stylesheet trick; <noscript> keeps them working without JS. -->
    <link href={fontsHref} rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href={fontsHref} rel="stylesheet" /></noscript>
  </head>
  <body class:list={{ 'on-cream': theme === 'light' }}>
    <!-- Film grain: fixed, click-through noise over the whole page. -->
    <div class="grain" aria-hidden="true"></div>

    <Nav lang={lang} current={current} tone={tone} flow={flow} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Vercel Web Analytics: cookieless page views. Only reports once deployed
         on Vercel with Analytics switched on in the project's dashboard. -->
    <Analytics />
  </body>
</html>

<style is:global>
  .grain {
    position: fixed;
    inset: -60px;
    z-index: 50;
    pointer-events: none;
    opacity: 0.09;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 180px 180px;
    animation: hb-grain 0.9s steps(3) infinite;
  }
</style>

<script>
  // Scroll reveal. Below the first section of each page, headings/paragraphs/
  // list items start slightly low + transparent and ease in when ~12% visible.
  // Anything already on screen at load is left alone (no flash), siblings
  // stagger by 90ms (max 3), and reduced-motion users get none of it
  // (global.css also un-hides .rv as a safety net).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const els = document.querySelectorAll<HTMLElement>(
      'main > section:not(:first-of-type) :is(h2, h3, p, li, dt, dd, blockquote, figcaption)',
    );
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('rv-in');
            io.unobserve(e.target);
          }
        }),
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );
    els.forEach((el) => {
      // Animate the <li> itself, not the paragraphs nested inside it.
      if (el.closest('li') && el.tagName !== 'LI') return;
      if (el.getBoundingClientRect().top < window.innerHeight * 0.92) return;
      const i = Math.min(3, Array.prototype.indexOf.call(el.parentElement?.children ?? [], el));
      el.style.setProperty('--rv-delay', `${i * 90}ms`);
      el.classList.add('rv');
      io.observe(el);
    });
  }
</script>

<script>
  // Conversion tracking. One delegated listener for every link on the page.
  // Event names (all carry a `location` property: nav, hero, footer, ...):
  //   cta_click               buttons marked data-track="cta_*"
  //   phone_click / sms_click / whatsapp_click / calendar_click / email_click   by href
  //   outbound_concierge_click   links to concierge.halobits.com
  //   language_switch          the EN / ES / RU toggle
  // Custom events need a Vercel plan that includes them; otherwise ignored.
  import { track } from '@vercel/analytics';

  const eventFor = (a: HTMLAnchorElement): string => {
    const href = a.getAttribute('href') ?? '';
    const tag = a.dataset.track ?? '';
    if (href.startsWith('tel:')) return 'phone_click';
    if (href.startsWith('sms:')) return 'sms_click';
    if (href.startsWith('mailto:')) return 'email_click';
    if (/^https?:\/\/(wa\.me|api\.whatsapp\.com)\//.test(href)) return 'whatsapp_click';
    if (/^https?:\/\/([^/]*\.)?(cal\.com|calendly\.com)\//.test(href) || tag === 'calendar_click') return 'calendar_click';
    if (/^https?:\/\/concierge\.halobits\.com/.test(href)) return 'outbound_concierge_click';
    if (tag === 'language_switch') return tag;
    if (tag.startsWith('cta')) return 'cta_click';
    return '';
  };
  const locationOf = (a: HTMLAnchorElement): string => {
    if (a.closest('header')) return 'nav';
    if (a.closest('footer')) return 'footer';
    // Buttons carry their own spot in the name: cta_talk_hero → "hero".
    const tag = a.dataset.track ?? '';
    return tag.startsWith('cta_') ? tag.split('_').slice(2).join('_') || 'page' : 'page';
  };

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a');
    if (!a) return;
    const name = eventFor(a);
    if (name) track(name, { location: locationOf(a), target: a.dataset.track ?? '' });
  });
</script>
