---
// PixelDivider.astro — a pixel "+" followed by a pixel-dashed rule. Separates the
// parts of a product description in the site's retro "bits" language.
// The "+" is a tiny bitmap ('#' = pixel) drawn as one crisp SVG path.
const plus = ['...#...', '...#...', '.#####.', '...#...', '...#...'];
const cols = plus[0].length;
const d = plus
  .flatMap((row, y) => [...row].map((c, x) => (c === '#' ? `M${x} ${y}h1v1h-1z` : '')))
  .join('');
---

<div class="pxd" aria-hidden="true">
  <svg viewBox={`0 0 ${cols} ${plus.length}`} shape-rendering="crispEdges" style={`--cols:${cols};--rows:${plus.length}`}>
    <path d={d} fill="currentColor"></path>
  </svg>
  <span class="rule"></span>
</div>

<style>
  .pxd {
    --px: 4px; /* size of one "pixel" */
    display: flex;
    align-items: center;
    gap: calc(var(--px) * 3);
    margin: clamp(20px, 2.2vw, 28px) 0 0;
    color: var(--apricot);
  }
  svg {
    flex: 0 0 auto;
    width: calc(var(--cols) * var(--px));
    height: calc(var(--rows) * var(--px));
  }
  .rule {
    flex: 1 1 auto;
    height: var(--px);
    opacity: 0.55;
    /* dashed rule built from square "pixels": on, off, on, off… */
    background: repeating-linear-gradient(90deg, currentColor 0 var(--px), transparent var(--px) calc(var(--px) * 2));
  }
</style>
