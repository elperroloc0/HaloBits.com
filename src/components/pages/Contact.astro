---
// pages/Contact.astro — collaboration-first contact. Two cards: email us, and a
// pointer to the product sites (which live elsewhere).
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].contact;
const meta = content[lang].meta.contact;
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Section tone="bg">
    <div class="s-head">
      <span class="tag">{c.kicker}</span>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </div>

    <div class="contact-grid">
      <div class="paper c-block">
        <h3>{c.emailTitle}</h3>
        <p>{c.emailBody}</p>
        <a href={`mailto:${c.email}`} class="btn btn-primary">{c.email}</a>
      </div>

      <div class="paper c-block">
        <h3>{c.productTitle}</h3>
        <p>{c.productBody}</p>
        <a
          href="https://concierge.halobits.com"
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer">{c.productCta}</a
        >
      </div>
    </div>

    <p class="addr">{c.addr}</p>
  </Section>
</Base>

<style>
  .s-head {
    margin-bottom: 40px;
  }
  .s-head .tag {
    margin-bottom: 18px;
  }
  .s-head h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-bottom: 16px;
  }
  .s-head .lead {
    max-width: 52ch;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 32px;
  }
  .c-block {
    padding: 30px;
  }
  .c-block h3 {
    margin-bottom: 8px;
    font-size: 1.3rem;
  }
  .c-block p {
    color: var(--muted);
    margin-bottom: 18px;
    max-width: 42ch;
  }
  .addr {
    color: var(--muted);
    font-size: 14px;
  }
  @media (max-width: 720px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
