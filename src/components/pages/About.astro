---
// pages/About.astro — studio story.
// Painted hero (fades into cream) → lead statement + definition list (cream) →
// band → dark "small team" section with a photo slot, two quote slots and CTAs.
// The photo and quotes are placeholders (dev-only); when real ones exist, drop
// them into the marked spots and flip SHOW_PLACEHOLDERS' gate off for them.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Band from '../ui/Band.astro';
import Button from '../ui/Button.astro';
import Fade from '../ui/Fade.astro';
import hill from '../../assets/miami-hill.jpg';

import { content } from '../../i18n/content';
import { SHOW_PLACEHOLDERS } from '../../lib/placeholders';
import { localizePath, type Lang } from '../../i18n/utils';
import { primaryCta } from '../../lib/cta';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const main = primaryCta(lang, 'about');

// Switches for parts we're not ready to show yet. Markup and copy stay in place;
// flip a flag to true to bring that part back, nothing else needs to change.
const SHOW_TEAM_INTRO = true; // "A small team. You talk to the people who build it." + text
const SHOW_TEAM_PHOTO = false; // group photo next to that text (no photo yet)
const SHOW_QUOTES = false; // client testimonials (no real quotes yet)
const t = content[lang].about;
const meta = content[lang].meta.about;

// Portraits are picked up by file name: src/assets/people/<slug>.jpg|png|webp
// (slug = name in lowercase with dashes, e.g. angel-garcia.jpg). Missing file →
// the card shows initials instead, so the build never breaks.
const portraits = import.meta.glob<{ default: ImageMetadata }>('../../assets/people/*.{jpg,jpeg,png,webp}', { eager: true });
const portraitFor = (name: string) => {
  const slug = name.toLowerCase().replace(/\s+/g, '-');
  const hit = Object.entries(portraits).find(([path]) => path.split('/').pop()!.startsWith(slug + '.'));
  return hit?.[1].default;
};
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
---

<Base lang={lang} title={meta.title} description={meta.description} current="about">
  <!-- 01 · Header -->
  <section class="hero">
    <Image
      src={hill}
      alt={t.alt}
      class="bg"
      widths={[800, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="scrim" aria-hidden="true"></div>
    <Fade color="#EFE6D6" height="36%" />
    <div class="wrap hero-in">
      <h1 class="display">{t.title}</h1>
    </div>
  </section>

  <!-- 02 · The studio -->
  <section class="studio">
    <div class="wrap">
      <p class="essential">{t.essential}</p>
      <dl class="details">
        {
          t.details.map((d) => (
            <div class="detail" tabindex="0">
              <dt>{d.t}</dt>
              <dd>
                <div>{d.b}</div>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Band from="#EFE6D6" to="#14110F" />

  <!-- 03 · Team -->
  <section class="team">
    <div class="wrap">
      {
        SHOW_TEAM_INTRO && (
          <div class="team-row">
            {
              SHOW_TEAM_PHOTO && SHOW_PLACEHOLDERS && (
                <div class="photo" role="img" aria-label={t.team.ph}>
                  <span>{t.team.ph}</span>
                </div>
              )
            }
            <div class="team-copy">
              <h2>{t.team.title}</h2>
            </div>
          </div>
        )
      }

      <ul class="people">
        {
          t.people.map((person) => {
            const img = portraitFor(person.name);
            return (
              <li class="person">
                {img ? (
                  <Image src={img} alt={person.photoAlt} class="portrait" widths={[360, 720]} sizes="(min-width: 700px) 360px, 70vw" loading="lazy" />
                ) : (
                  <div class="portrait portrait--initials" aria-hidden="true">
                    <span>{initials(person.name)}</span>
                  </div>
                )}
                <p class="p-name">{person.name}</p>
                <p class="p-role">{person.role}</p>
              </li>
            );
          })
        }
      </ul>

      {
        SHOW_QUOTES && SHOW_PLACEHOLDERS && (
          <div class="quotes">
            <figure class="quote">
              <blockquote>“{t.team.q}”</blockquote>
              <figcaption>{t.team.qn}</figcaption>
            </figure>
            <figure class="quote quote--low">
              <blockquote>“{t.team.q2}”</blockquote>
              <figcaption>{t.team.qn}</figcaption>
            </figure>
          </div>
        )
      }

      <div class="actions">
        <Button href={main.href} size="lg" external={main.external} track={main.track}>{main.label}</Button>
        <Button href={localizePath('/what-we-build/', lang)} size="lg" variant="outline" track="cta_build_about">{t.cta2}</Button>
      </div>
    </div>
  </section>
</Base>

<script>
  // A tile that grows wider than the space left in its row would wrap to the next
  // line right under the cursor and flicker. So when one opens we cap its answer
  // width to the room that is actually left in the row (never below ~12rem).
  const details = document.querySelector<HTMLElement>('.details');
  details?.querySelectorAll<HTMLElement>('.detail').forEach((tile) => {
    const fit = () => {
      const room = details.getBoundingClientRect().right - tile.getBoundingClientRect().left;
      const pad = parseFloat(getComputedStyle(tile).paddingLeft) + parseFloat(getComputedStyle(tile).paddingRight);
      const max = 23 * parseFloat(getComputedStyle(document.documentElement).fontSize);
      tile.style.setProperty('--dd-w', `${Math.max(192, Math.min(max, room - pad - 2))}px`);
    };
    tile.addEventListener('pointerenter', fit);
    tile.addEventListener('focusin', fit);
  });
</script>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 82vh, 860px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 40% 70%;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 17, 15, 0.62) 0%,
      rgba(20, 17, 15, 0.3) 36%,
      rgba(20, 17, 15, 0) 64%
    );
  }
  .hero-in {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: clamp(128px, 18vh, 200px);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 7vw, 6.8rem);
    max-width: 22ch;
  }

  .studio {
    background: var(--cream);
    color: var(--ink);
    padding: clamp(40px, 6vw, 100px) 0 clamp(40px, 6vw, 90px);
  }
  .essential {
    max-width: 66rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  /* Compact tiles, each as small as its question. Hover or keyboard focus grows
     the tile (width and height) to fit the answer and the others reflow around
     it, so the section stays short. The answer stays in the DOM, so screen
     readers read it. */
  .details {
    --dd-w: min(23rem, calc(100vw - 2 * var(--gutter) - 56px));
    margin-top: clamp(56px, 7vw, 100px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 12px;
  }
  .detail {
    position: relative;
    padding: 20px 56px 20px 26px;
    border-radius: 20px;
    background: var(--ink);
    color: var(--cream);
    cursor: default;
    transition:
      background-color 0.6s ease 0.2s,
      color 0.6s ease 0.2s;
  }
  .detail::after {
    content: '+';
    position: absolute;
    top: 17px;
    right: 22px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1;
    transition: transform 0.6s ease 0.2s;
  }
  dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    white-space: nowrap;
  }
  /* Collapsed: zero width and zero-height row. Open: both grow smoothly. */
  dd {
    display: grid;
    grid-template-rows: 0fr;
    width: 0;
    color: var(--ink);
    opacity: 0;
    /* Closing waits 0.2s (so a passing cursor doesn't make tiles jump), then eases shut. */
    transition:
      grid-template-rows 0.8s cubic-bezier(0.25, 0.6, 0.2, 1) 0.2s,
      width 0.8s cubic-bezier(0.25, 0.6, 0.2, 1) 0.2s,
      opacity 0.5s ease 0.2s;
  }
  dd > div {
    min-height: 0;
    overflow: hidden;
    width: var(--dd-w);
    padding-top: 0;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.55;
    text-wrap: pretty;
    transition: padding-top 0.8s cubic-bezier(0.25, 0.6, 0.2, 1) 0.2s;
  }
  .detail:hover,
  .detail:focus-visible,
  .detail:focus-within {
    background: var(--butter);
    color: var(--ink);
    outline: none;
    /* Opening starts after a short pause, then glides. */
    transition-delay: 0.12s;
  }
  .detail:hover dd,
  .detail:focus-visible dd,
  .detail:focus-within dd {
    grid-template-rows: 1fr;
    width: var(--dd-w);
    opacity: 1;
    transition-delay: 0.12s;
  }
  .detail:hover dd > div,
  .detail:focus-visible dd > div,
  .detail:focus-within dd > div {
    padding-top: 12px;
    transition-delay: 0.12s;
  }
  .detail:hover::after,
  .detail:focus-visible::after,
  .detail:focus-within::after {
    transform: rotate(45deg);
    transition-delay: 0.12s;
  }
  .detail:focus-visible {
    box-shadow: 0 0 0 3px var(--rust);
  }
  /* Touch screens have no hover: show every answer, stacked. */
  @media (hover: none) {
    .details {
      flex-direction: column;
      align-items: stretch;
    }
    .detail {
      background: var(--butter);
      color: var(--ink);
    }
    .detail::after {
      display: none;
    }
    dt {
      white-space: normal;
    }
    dd {
      grid-template-rows: 1fr;
      width: auto;
      opacity: 1;
    }
    dd > div {
      width: auto;
      padding-top: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .detail,
    .detail::after,
    dd,
    dd > div {
      transition: none;
    }
  }

  .team {
    padding: clamp(30px, 5vw, 80px) 0 clamp(96px, 12vw, 180px);
  }
  .team-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 40px clamp(32px, 5vw, 80px);
  }
  .photo {
    flex: 6 1 440px;
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    background: var(--ink-soft) repeating-linear-gradient(135deg, rgba(239, 230, 214, 0.05) 0 1px, transparent 1px 12px);
    display: flex;
    align-items: flex-end;
    padding: 18px;
  }
  .photo span {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.5;
  }
  .team-copy {
    flex: 5 1 320px;
    max-width: 32rem;
  }
  .team-copy h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 3.3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .people {
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 260px));
    gap: 40px clamp(24px, 4vw, 56px);
  }
  .portrait {
    width: clamp(160px, 18vw, 220px);
    height: auto; /* the <img> carries a height attribute that would otherwise beat aspect-ratio */
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 28%; /* keep the face centred in the circle */
    border-radius: 50%;
    background: var(--ink-soft);
  }
  .portrait--initials {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ink-soft) repeating-linear-gradient(135deg, rgba(239, 230, 214, 0.05) 0 1px, transparent 1px 12px);
  }
  .portrait--initials span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3.4rem;
    letter-spacing: -0.04em;
    color: var(--muted);
  }
  .p-name {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }
  .p-role {
    margin-top: 4px;
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--apricot);
  }
  .quotes {
    display: flex;
    flex-wrap: wrap;
    gap: 56px clamp(40px, 8vw, 140px);
    margin-top: clamp(88px, 10vw, 150px);
    padding-left: clamp(0px, 6vw, 110px);
  }
  .quote {
    flex: 1 1 320px;
    max-width: 34rem;
  }
  .quote--low {
    margin-top: clamp(0px, 8vw, 120px);
  }
  blockquote {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--muted);
  }
  figcaption {
    margin-top: 18px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
    margin-top: clamp(88px, 10vw, 150px);
  }
  /* no photo (production): the copy is the only child, so don't bottom-align */
  .team-row:has(> .team-copy:only-child) {
    align-items: flex-start;
  }
  .team-copy {
    max-width: 40rem;
  }
</style>
