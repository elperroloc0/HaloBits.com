---
// pages/Faq.astro — cream page: intro on the left, accordion on the right.
// Each question is a <button aria-expanded aria-controls> inside an <h2>; the
// "+" icon turns into "×" (45° rotate) when open. The first item starts open.
// Progressive enhancement: without JS every answer is shown (see <noscript>).
import Base from '../../layouts/Base.astro';
import Band from '../ui/Band.astro';
import Button from '../ui/Button.astro';
import { content } from '../../i18n/content';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].faq;
const meta = content[lang].meta.faq;
---

<Base lang={lang} title={meta.title} description={meta.description} current="faq" tone="light" flow theme="light">
  <section class="faq">
    <div class="wrap faq-in">
      <div class="intro">
        <h1 class="display">{t.title}</h1>
        <p class="lead">{t.lead}</p>
        <Button href={localizePath('/contact/', lang)} variant="ink" class="ask">{t.ask}</Button>
      </div>

      <div class="list">
        {
          t.items.map((q, i) => (
            <div class="item">
              <h2>
                <button type="button" class="q" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-${i}`}>
                  <span>{q.q}</span>
                  <svg
                    class="icon"
                    width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="9.5" />
                    <path d="M12 8v8M8 12h8" />
                  </svg>
                </button>
              </h2>
              <div class="a" id={`faq-${i}`} hidden={i !== 0}>
                <p>{q.a}</p>
                {q.link && q.href && <a href={localizePath(q.href, lang)}>{q.link}</a>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Band from="#EFE6D6" to="#14110F" />

  <!-- No JS → show every answer instead of hiding them behind dead buttons. -->
  <noscript>
    <style is:inline>
      .a[hidden] {
        display: block !important;
      }
    </style>
  </noscript>
</Base>

<style>
  .faq {
    padding: clamp(72px, 10vw, 150px) 0 clamp(40px, 6vw, 90px);
    background: var(--cream);
    color: var(--ink);
  }
  .faq-in {
    display: flex;
    flex-wrap: wrap;
    gap: 48px clamp(40px, 7vw, 120px);
    align-items: flex-start;
  }
  .intro {
    flex: 4 1 300px;
    max-width: 30rem;
  }
  h1 {
    font-size: clamp(2.6rem, 5.4vw, 5rem);
  }
  .lead {
    margin-top: 24px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-on-cream);
  }
  :global(.btn.ask) {
    margin-top: 28px;
  }

  .list {
    flex: 7 1 480px;
    display: flex;
    flex-direction: column;
  }
  .item {
    border-bottom: 1px solid rgba(20, 17, 15, 0.14);
  }
  .q {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    background: none;
    border: 0;
    cursor: var(--cursor-hand);
    text-align: left;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .q:hover {
    color: var(--rust);
  }
  .icon {
    flex: 0 0 28px;
    transition: transform 0.3s var(--ease);
  }
  .q[aria-expanded='true'] .icon {
    transform: rotate(45deg);
  }
  .a {
    padding: 0 48px 28px 0;
    max-width: 40rem;
  }
  .a[hidden] {
    display: none;
  }
  .a p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-on-cream);
    text-wrap: pretty;
  }
  .a a {
    display: inline-flex;
    margin-top: 12px;
    padding: 6px 0;
    font-weight: 500;
    text-underline-offset: 5px;
  }
</style>

<script>
  // One handler for the whole list. Questions toggle independently (several can
  // be open at once), matching the design.
  document.querySelectorAll<HTMLButtonElement>('.faq .q').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = open;
    });
  });
</script>
