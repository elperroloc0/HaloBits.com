---
// pages/WhatWeBuild.astro — one screen, not a long scroll.
//   [ Products | Services ]            ← mode switch
//   AI Concierge · Van Tracker · …      ← project tabs (Products only)
//   one panel at a time
//
// Adding a project = one object in `buildPage.projects` (content.ts, both
// languages) + optional screenshot at src/assets/projects/<id>.png|jpg|webp.
// Without JavaScript every panel is simply shown one after another (the tab
// buttons are hidden until the script below switches the page into tab mode).
// Screenshots that don't exist yet are dev-only placeholders (lib/placeholders.ts).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Button from '../ui/Button.astro';
import { content } from '../../i18n/content';
import { SHOW_PLACEHOLDERS } from '../../lib/placeholders';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang].buildPage;
const meta = content[lang].meta.whatWeBuild;
const contact = localizePath('/contact/', lang);

const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/*.{jpg,jpeg,png,webp}', { eager: true });
const shotFor = (id: string) => Object.entries(shots).find(([path]) => path.split('/').pop()!.startsWith(id + '.'))?.[1].default;
const href = (h: string) => (h.startsWith('/') ? localizePath(h, lang) : h);
---

<Base lang={lang} title={meta.title} description={meta.description} current="build" flow>
  <section class="head">
    <div class="wrap">
      <h1 class="display">{t.title}</h1>
      <div class="head-row">
        <p class="lead">{t.lead}</p>
        <!-- Mode switch: Products | Services (the script turns it on) -->
        <div class="modes" role="group" aria-label={t.modeLabel} data-js hidden>
          <button type="button" data-mode="products" aria-pressed="true">{t.products}</button>
          <button type="button" data-mode="services" aria-pressed="false">{t.services}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="stage" id="stage">
    <div class="wrap">
      <!-- ───── Products ───── -->
      <div class="mode-panel" data-panel="products">
        <div class="tabs" role="tablist" aria-label={t.projectsLabel} data-js hidden>
          {
            t.projects.map((p, i) => (
              <button type="button" role="tab" class="tab" id={`tab-${p.id}`} data-project={p.id} aria-controls={p.id} aria-selected={i === 0 ? 'true' : 'false'}>
                {p.name}
              </button>
            ))
          }
        </div>

        {
          t.projects.map((p) => {
            const img = shotFor(p.id);
            const showMedia = img || SHOW_PLACEHOLDERS;
            return (
              <article class="project" id={p.id} role="tabpanel" aria-labelledby={`tab-${p.id}`} data-project-panel={p.id}>
                <div class="copy">
                  <p class="meta">
                    <span class="for">{p.for}</span>
                  </p>
                  <h2 class="display name">{p.name}</h2>
                  <p class="desc">{p.desc}</p>

                  {p.includes && (
                    <div class="block">
                      <p class="eyebrow label">{t.includes}</p>
                      <ul class="includes">
                        {p.includes.map((i) => (
                          <li>
                            <span class="bullet" aria-hidden="true" />
                            {i}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <div class="block">
                    <p class="eyebrow label">{t.who}</p>
                    <p class="who">{p.who}</p>
                  </div>

                  <Button href={href(p.cta.href)} external={p.cta.external} variant={p.cta.external ? 'cream' : 'outline'} class="cta">
                    {p.cta.label}
                  </Button>
                </div>

                {(showMedia || p.stats) && (
                  <div class={`side side--${p.media.shape}`}>
                    {showMedia && (
                      <figure class={`media media--${p.media.shape}`}>
                        {img ? (
                          <Image src={img} alt={p.media.alt} widths={[480, 960, 1400]} sizes="(min-width: 1000px) 50vw, 100vw" loading="lazy" />
                        ) : (
                          <div class="ph" role="img" aria-label={p.media.ph}>
                            <span>{p.media.ph}</span>
                          </div>
                        )}
                      </figure>
                    )}
                    {p.stats && p.statsCaption && <p class="eyebrow stats-caption">{p.statsCaption}</p>}
                    {p.stats && (
                      <dl class="stats">
                        {p.stats.map((s) => (
                          <div class="stat">
                            <dt>{s.v}</dt>
                            <dd>{s.l}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                  </div>
                )}
              </article>
            );
          })
        }
      </div>

      <!-- ───── Services ───── -->
      <div class="mode-panel" data-panel="services" id="services">
        <ul class="services">
          {
            t.servicesPanel.items.map((s) => (
              <li class="service">
                <h2>{s.t}</h2>
                <div class="service-body">
                  <p>{s.b}</p>
                  {s.from && (
                    <p class="from">
                      {t.servicesPanel.fromLabel} <strong>{s.from}</strong>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
        <div class="services-foot">
          <p class="services-lead">{t.servicesPanel.lead}</p>
          <Button href={contact} class="cta-services">{t.servicesPanel.cta}</Button>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── header ── */
  .head {
    padding: clamp(40px, 5vw, 72px) 0 0;
  }
  .head h1 {
    font-size: clamp(2.4rem, 5.4vw, 5rem);
    max-width: 18ch;
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    margin-top: clamp(20px, 2.4vw, 32px);
  }
  .lead {
    max-width: 34rem;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--soft);
    text-wrap: pretty;
  }

  .stage {
    padding: 0 0 clamp(96px, 12vw, 180px);
    scroll-margin-top: 80px;
  }

  /* ── mode switch (segmented pill) ── */
  .modes {
    display: inline-flex;
    padding: 4px;
    border-radius: 999px;
    border: 1px solid rgba(239, 230, 214, 0.3);
  }
  .modes[hidden] {
    display: none;
  }
  .modes button {
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--cream);
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: var(--cursor-hand);
    transition: background 0.2s, color 0.2s;
  }
  .modes button[aria-pressed='true'] {
    background: var(--cream);
    color: var(--ink);
  }

  /* ── project tabs ── */
  .tabs {
    display: flex;
    gap: clamp(22px, 3.4vw, 44px);
    margin-top: clamp(24px, 3vw, 40px);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs[hidden] {
    display: none;
  }
  .tab {
    flex: 0 0 auto;
    position: relative;
    padding: 12px 0 14px;
    border: 0;
    background: none;
    cursor: var(--cursor-hand);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    letter-spacing: -0.03em;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.2s;
  }
  .tab:hover,
  .tab[aria-selected='true'] {
    color: var(--cream);
  }
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--butter);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  /* ── a project panel ── */
  .project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px clamp(40px, 6vw, 100px);
    margin-top: clamp(28px, 3.4vw, 52px);
  }
  .project[hidden],
  .mode-panel[hidden] {
    display: none;
  }
  .copy {
    flex: 5 1 340px;
    max-width: 36rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 14px;
    font-weight: 500;
  }
  .for {
    color: var(--apricot);
  }
  .name {
    margin-top: 12px;
    font-size: clamp(2.6rem, 5vw, 4.6rem);
  }
  .desc {
    margin-top: 22px;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    text-wrap: pretty;
  }
  /* number with its label underneath, both flush with the right edge of the picture */
  .stats-caption {
    margin-top: 28px;
    text-align: right;
    color: var(--apricot);
  }
  .stats {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px 40px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 10px;
  }
  .stat dt {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 4.4rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--butter);
  }
  .stat dd {
    margin: 0;
    max-width: 16rem;
    font-size: 15px;
    line-height: 1.4;
    color: var(--soft);
  }
  .block {
    margin-top: 28px;
  }
  .label {
    color: var(--muted);
  }
  .who {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--soft);
  }
  .includes {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 16px;
    line-height: 1.5;
  }
  .includes li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .bullet {
    flex: 0 0 6px;
    height: 6px;
    border-radius: 50%;
    border: 1.5px solid var(--apricot);
    transform: translateY(-2px);
  }
  :global(.btn.cta) {
    margin-top: 32px;
  }

  /* right-hand column: screenshot (or dev placeholder) with the stats under it */
  .side {
    flex: 6 1 420px;
    min-width: 0;
  }
  .side--phone {
    flex: 0 1 320px;
    margin: 0 auto;
  }
  .media {
    min-width: 0;
  }
  .media :global(img),
  .ph {
    width: 100%;
    height: auto;
    border-radius: 10px;
  }
  /* Real screenshots keep their own proportions (nothing cropped); only the
     dev placeholders get a fixed frame. */
  .media--wide .ph {
    aspect-ratio: 16 / 9;
  }
  .media--standard .ph {
    aspect-ratio: 4 / 3;
  }
  .media--phone :global(img),
  .media--phone .ph {
    aspect-ratio: 852 / 1846; /* our Van Tracker screenshot's ratio, nothing is cropped */
    border-radius: 36px;
    object-fit: cover;
    object-position: top;
  }
  .ph {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    background: var(--ink-soft) repeating-linear-gradient(135deg, rgba(239, 230, 214, 0.05) 0 1px, transparent 1px 12px);
  }
  .ph span {
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── services ── */
  .mode-panel + .mode-panel {
    margin-top: clamp(72px, 9vw, 130px); /* only visible in the no-JS stacked layout */
  }
  .services {
    margin: clamp(28px, 3.4vw, 52px) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 52px);
  }
  .service {
    display: flex;
    flex-wrap: wrap;
    gap: 10px clamp(32px, 6vw, 96px);
  }
  .service h2 {
    flex: 0 1 340px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .service-body {
    flex: 1 1 340px;
    max-width: 38rem;
  }
  .service-body p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--soft);
    text-wrap: pretty;
  }
  .service-body .from {
    margin-top: 10px;
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--apricot);
  }
  .service-body .from strong {
    font-weight: 600;
  }
  .services-foot {
    margin-top: clamp(48px, 6vw, 88px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 32px;
  }
  .services-lead {
    max-width: 30rem;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>

<script>
  // Turns the stacked page into tab mode and keeps the URL hash in sync, so old
  // links like /what-we-build/#van (and #custom → Services) still land correctly.
  const root = document.querySelector('main');
  if (root) {
    const modeBtns = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const modePanels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-project]');
    const projects = root.querySelectorAll<HTMLElement>('[data-project-panel]');
    const firstProject = projects[0]?.dataset.projectPanel ?? '';

    root.querySelectorAll<HTMLElement>('[data-js]').forEach((el) => (el.hidden = false));

    const show = (mode: 'products' | 'services', project = firstProject, updateHash = true) => {
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
      modePanels.forEach((p) => (p.hidden = p.dataset.panel !== mode));
      tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.project === project)));
      projects.forEach((p) => (p.hidden = p.dataset.projectPanel !== project));
      if (updateHash) history.replaceState(null, '', mode === 'services' ? '#services' : `#${project}`);
    };

    const fromHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (h === 'services' || h === 'custom') return show('services', firstProject, false);
      const known = [...projects].some((p) => p.dataset.projectPanel === h);
      show('products', known ? h : firstProject, false);
    };

    modeBtns.forEach((b) => b.addEventListener('click', () => show(b.dataset.mode as 'products' | 'services')));
    tabs.forEach((b) => b.addEventListener('click', () => show('products', b.dataset.project)));

    // Arrow keys move between tabs (standard tablist behaviour).
    root.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const list = [...tabs];
      const i = list.findIndex((b) => b.getAttribute('aria-selected') === 'true');
      const next = list[(i + (ev.key === 'ArrowRight' ? 1 : list.length - 1)) % list.length];
      next.focus();
      next.click();
    });

    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>
