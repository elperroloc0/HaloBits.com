---
// pages/WhatWeBuild.astro
//   1. Header
//   2. LIVE NOW — Concierge AI (protagonist block, larger than everything else)
//   3. Capabilities grid ("A few things we build well")
//   4. On the way (small roadmap teaser)
//   5. Closing CTA (page-specific copy via CTA props)
import Base from '../../layouts/Base.astro';
import Section from '../Section.astro';
import CTA from '../sections/CTA.astro';
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].whatWeBuildPage;
const meta = content[lang].meta.whatWeBuild;
---

<Base lang={lang} title={meta.title} description={meta.description}>
  <Section tone="bg" blobs blobVariant="a">
    <!-- 1. Header -->
    <div class="s-head">
      <span class="tag">{c.kicker}</span>
      <h1>{c.title}</h1>
    </div>

    <!-- 2. LIVE NOW — Concierge (protagonist) -->
    <div class="live card">
      <div class="live-copy">
        <span class="live-label"><span class="pulse"></span>{c.live.label}</span>
        <h2>{c.live.name}</h2>
        <p class="live-body">{c.live.body}</p>
        <!-- Opens in a new tab → the product's own site -->
        <a
          href={c.live.href}
          class="btn btn-solid"
          target="_blank"
          rel="noopener noreferrer">{c.live.cta} →</a
        >
      </div>

      <!-- Product visual — CSS-built call-UI card (swap for a real screenshot
           later by replacing this .product block with an <img>). -->
      <div class="product" aria-hidden="true">
        <div class="product-bar">
          <span class="d d1"></span><span class="d"></span><span class="d"></span>
          <span class="product-title">Concierge</span>
        </div>
        <div class="product-body">
          <div class="prow">
            <span class="livedot"></span>
            <span class="prow-txt">On a call</span>
            <span class="lang-chip">EN · ES</span>
          </div>
          <div class="wave">
            <span style="--h:40%"></span><span style="--h:72%"></span>
            <span style="--h:100%"></span><span style="--h:55%"></span>
            <span style="--h:84%"></span><span style="--h:36%"></span>
            <span style="--h:66%"></span><span style="--h:94%"></span>
            <span style="--h:48%"></span><span style="--h:76%"></span>
            <span style="--h:30%"></span><span style="--h:60%"></span>
          </div>
          <div class="sk"><span class="l w90"></span><span class="l w70"></span></div>
          <div class="chips">
            <span class="chip">✓ Booking confirmed</span>
            <span class="chip">✓ Guest remembered</span>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- 3. Capabilities -->
  <Section tone="surface" blobs blobVariant="b">
    <div class="s-head">
      <span class="tag">{c.capKicker}</span>
      <h2>{c.capTitle}</h2>
      <p class="lead">{c.capLead}</p>
    </div>
    <div class="cap-grid">
      {
        c.capabilities.map((cap) => (
          <div class="cap paper">
            <h3>{cap.title}</h3>
            <p>{cap.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- 4. On the way -->
  <Section tone="bg" blobs blobVariant="c">
    <div class="next">
      <span class="tag">{c.next.kicker}</span>
      <h2>{c.next.title}</h2>
      <p class="lead">{c.next.body}</p>
    </div>
  </Section>

  <!-- 5. Closing CTA -->
  <CTA lang={lang} title={c.cta.title} body={c.cta.body} button={c.cta.button} />
</Base>

<style>
  .s-head {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .s-head .tag {
    align-self: flex-start;
  }
  .s-head h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    max-width: 16ch;
  }

  /* ── LIVE block — the page protagonist ─────────────────────────── */
  .live {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .live-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .live-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #4ec98a;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22a06b;
    box-shadow: 0 0 0 4px rgba(34, 160, 107, 0.16);
  }
  .live h2 {
    font-size: clamp(2rem, 3.5vw, 3rem);
  }
  .live-body {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 42ch;
  }

  /* ── Product card (CSS mockup) ─────────────────────────────────── */
  .product {
    background: rgba(12, 11, 10, 0.55);
    border: 1px solid var(--line-2);
    border-radius: var(--r);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    width: 100%;
    max-width: 420px;
    justify-self: end;
  }
  .product-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
  }
  .d {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .d1 {
    background: rgba(31, 63, 195, 0.6);
  }
  .product-title {
    margin-left: 8px;
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--muted-2);
  }
  .product-body {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .prow {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .livedot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22a06b;
    box-shadow: 0 0 0 4px rgba(34, 160, 107, 0.16);
  }
  .prow-txt {
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
  }
  .lang-chip {
    margin-left: auto;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb4ff;
    background: rgba(31, 63, 195, 0.18);
    border: 1px solid rgba(31, 63, 195, 0.3);
    padding: 4px 10px;
    border-radius: var(--pill);
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 54px;
  }
  .wave span {
    flex: 1;
    height: var(--h);
    background: linear-gradient(var(--accent-light), var(--accent));
    border-radius: var(--pill);
    opacity: 0.9;
  }
  .sk {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .l {
    height: 9px;
    border-radius: var(--pill);
    background: var(--line-2);
  }
  .w90 {
    width: 90%;
  }
  .w70 {
    width: 70%;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    padding: 7px 12px;
    border-radius: var(--pill);
  }

  /* ── Capabilities grid ─────────────────────────────────────────── */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 16px;
  }
  .cap {
    padding: 26px 24px;
  }
  .cap h3 {
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 10px;
  }
  .cap p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ── On the way ────────────────────────────────────────────────── */
  .next {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .next .lead {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .live {
      grid-template-columns: 1fr;
    }
    .product {
      justify-self: start;
    }
  }
</style>
