---
// Hero.astro — home hero: full-bleed painting, two-line headline ("A partner."
// in butter), sub, two CTAs lowered toward the water, and a fade into the sand
// colour of the next section. The nav floats transparently on top of this.
import { Image } from 'astro:assets';
import hero from '../../assets/hero-computer.jpg';
import Button from '../ui/Button.astro';
import Fade from '../ui/Fade.astro';
import { content } from '../../i18n/content';
import { primaryCta } from '../../lib/cta';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.hero;
const main = primaryCta(lang, 'hero');
const projectsHref = localizePath('/what-we-build/', lang);
---

<section class="hero">
  <Image
    src={hero}
    alt={c.alt}
    class="bg"
    widths={[800, 1280, 1672]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="scrim" aria-hidden="true"></div>

  <div class="wrap copy">
    <h1 class="display">
      <span>{c.l1}</span>
      <span class="accent">{c.l2}</span>
    </h1>
    <p class="sub">{c.sub}</p>
    <div class="ctas">
      <Button href={main.href} size="sm" external={main.external} track={main.track}>{main.label}</Button>
      <Button href={projectsHref} size="sm" variant="outline" class="ghost" track="cta_projects_hero">{c.projects}</Button>
    </div>
  </div>

  <Fade color="#14110F" height="34%" />
  <div class="wrap cap"><span>Miami, FL · {c.tag}</span></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(680px, 100svh);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 78% 70%;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 70% at 18% 40%, rgba(20, 17, 15, 0.5), rgba(20, 17, 15, 0) 70%),
      linear-gradient(
        180deg,
        rgba(20, 17, 15, 0.6) 0%,
        rgba(20, 17, 15, 0.34) 34%,
        rgba(20, 17, 15, 0.08) 62%,
        rgba(20, 17, 15, 0) 80%,
        rgba(20, 17, 15, 0.45) 100%
      );
  }
  .copy {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: clamp(128px, 19vh, 210px);
  }
  h1 {
    font-size: clamp(3rem, 8.2vw, 8.4rem);
    color: var(--cream);
    text-wrap: initial;
  }
  h1 span {
    display: block;
  }
  .accent {
    color: var(--butter);
  }
  .sub {
    margin-top: clamp(22px, 3vw, 32px);
    max-width: 30rem;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.5;
    color: #f4ede0;
    text-wrap: pretty;
    text-shadow: 0 1px 18px rgba(20, 17, 15, 0.35);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    margin-top: clamp(44px, 9vh, 120px);
  }
  /* Astro does not scope classes passed into a child component, hence :global. */
  /* The transparent button sits on the brightest part of the painting, so give
     it a faint dark glass + stronger edge to keep the label readable. */
  :global(.btn.ghost) {
    background: rgba(20, 17, 15, 0.28);
    border-color: rgba(239, 230, 214, 0.75);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  :global(.btn.ghost:hover) {
    background: var(--cream);
  }
  .cap {
    position: relative;
    z-index: 2;
    margin-top: auto;
    width: 100%;
    padding-top: 40px;
    padding-bottom: 22px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
