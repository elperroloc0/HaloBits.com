---
// Hero.astro — full-viewport dark hero.
//
// Z-INDEX LAYERING (see global.css for the full system):
//   0  → haura blobs (big atmospheric blurs behind glass)
//   5  → venn orbs (the right-column visual, also behind glass)
//   10 → GLASS (fixed in Base.astro — blurs everything 0-9)
//   20 → .hero-content (text, buttons — rendered sharp above glass)
//
// The haura + venn orbs are absolutely positioned siblings of .hero-content,
// NOT children of it, so they belong to the root stacking context at their
// own z-indices, independent of the text layer.
import { content } from '../../i18n/content';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].hero;
---

<section class="hero-section">

  <!-- ── Layer 0: Haura blobs — atmospheric background glow ────────────
       position:absolute with no z-index → renders at z:0 in root context,
       below the glass (z:10). The glass blurs these as you look through it. -->
  <div class="haura ha" aria-hidden="true"></div>
  <div class="haura hb" aria-hidden="true"></div>
  <div class="haura hc" aria-hidden="true"></div>

  <!-- ── Frosted glass within the hero only ───────────────────────────
       position:absolute (not fixed) so it only affects the hero section
       and doesn't interfere with Chrome compositing on sections below.
       It blurs the haura + venn orbs behind it and lets the text (z:20)
       sit sharp on top. -->
  <div class="hero-glass" aria-hidden="true"></div>

  <!-- ── Layer 5: Venn orbs — right-side visual, behind glass ──────────
       Positioned absolutely to sit in the right half. z-index:5 keeps
       them below the glass. The glass blurs them to a soft wash of colour. -->
  <div class="venn-wrap" aria-hidden="true">
    <div class="venn">
      <div class="vorb v1"></div>
      <div class="vorb v2"></div>
      <div class="vorb v3"></div>
    </div>
  </div>

  <!-- ── Layer 20: Hero text — sharp, above the glass ─────────────────
       position:relative + z-index:20 lifts this above the glass layer so
       the text renders crisp while the orbs behind appear frosted. -->
  <div class="hero-content">
    <div class="hero-left">
      <h1>{c.slogan}</h1>
      <p class="lead">{c.sub}</p>
      <div class="hero-btns">
        <a href={localizePath('/what-we-build/', lang)} class="btn btn-solid">
          {c.ctaBuild} →
        </a>
        <a href={localizePath('/contact/', lang)} class="btn btn-ghost">
          {c.ctaTalk}
        </a>
      </div>
    </div>
  </div>

</section>

<style>
  /* ── Section shell ──────────────────────────────────────────────────── */
  .hero-section {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    background: transparent;
  }
  /* Fade at the bottom of the hero so it flows into the next section */
  .hero-section::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 180px;
    background: linear-gradient(to top, rgba(12,11,10,0.75), transparent);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Hero-scoped frosted glass ─────────────────────────────────────
     position:absolute + z-index:6 places it above the haura (auto) and
     venn orbs (5), below hero-content (20). backdrop-filter here is safe
     because this element is NOT fixed — it lives only in the hero section
     and doesn't interfere with Chrome's compositing of other sections. */
  .hero-glass {
    position: absolute;
    inset: 0;
    z-index: 6;
    backdrop-filter: blur(24px) saturate(130%);
    -webkit-backdrop-filter: blur(24px) saturate(130%);
    background: rgba(12, 11, 10, 0.05);
    pointer-events: none;
  }

  /* ── Haura blobs (z: auto → effectively 0) ──────────────────────────
     Large, very blurry radial-gradient circles that create the atmospheric
     colour behind the glass. The grain overlay on top adds texture. */
  .haura {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    /* No z-index — stays below the fixed glass at z:10 */
  }
  .ha {
    width: 780px; height: 780px;
    right: -140px; top: -100px;
    background: radial-gradient(circle at 40% 35%, var(--cr) 0%, var(--pw) 50%, transparent 74%);
    filter: blur(100px);
    opacity: 0.44;
    animation: hb-float-a 18s ease-in-out infinite;
  }
  .hb {
    width: 480px; height: 480px;
    right: 80px; bottom: -60px;
    background: radial-gradient(circle at 50% 42%, var(--or) 0%, transparent 70%);
    filter: blur(85px);
    opacity: 0.36;
    animation: hb-float-b 22s ease-in-out infinite;
  }
  .hc {
    width: 460px; height: 460px;
    left: -120px; bottom: 60px;
    background: radial-gradient(circle at 52% 46%, var(--pw) 0%, transparent 68%);
    filter: blur(90px);
    opacity: 0.18;
    animation: hb-float-b 26s ease-in-out infinite reverse;
  }

  /* ── Venn orbs wrapper (z: 5) ───────────────────────────────────────
     Absolutely positioned to the right half of the viewport. z-index:5
     keeps it below the glass. The three overlapping orbs create the
     "venn diagram" of colour that bleeds through the frosted glass. */
  .venn-wrap {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    pointer-events: none;
  }
  .venn {
    position: relative;
    width: 420px; height: 420px;
  }
  .vorb {
    position: absolute;
    border-radius: 50%;
    filter: blur(18px);
  }
  .v1 {
    width: 270px; height: 270px; top: 10px; left: 10px;
    background: radial-gradient(circle at 42% 38%, var(--vb) 0%, oklch(0.42 0.10 258) 60%, transparent 85%);
    opacity: 0.88;
    animation: hb-float-a 15s ease-in-out infinite;
  }
  .v2 {
    width: 250px; height: 250px; bottom: 10px; right: 10px;
    background: radial-gradient(circle at 50% 44%, var(--vm) 0%, oklch(0.36 0.07 330) 60%, transparent 85%);
    opacity: 0.82;
    animation: hb-float-b 19s ease-in-out infinite;
  }
  .v3 {
    width: 240px; height: 240px; bottom: 30px; left: 80px;
    background: radial-gradient(circle at 50% 42%, var(--vo) 0%, oklch(0.52 0.11 38) 60%, transparent 85%);
    opacity: 0.80;
    animation: hb-float-a 12s ease-in-out infinite reverse;
  }

  /* ── Hero content (z: 20, above glass) ──────────────────────────────
     position:relative + z-index:20 escapes the glass layer. Text is
     rendered sharp on top of the frosted glass. */
  .hero-content {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: var(--maxw-wide);
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(clamp(4rem, 8vw, 6rem) + 60px) clamp(1.5rem, 5vw, 2.5rem) clamp(4rem, 8vw, 6rem);
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 580px; /* left half */
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    background: rgba(240, 235, 229, 0.06);
    border: 1px solid rgba(240, 235, 229, 0.10);
    padding: 7px 14px;
    border-radius: var(--pill);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: rgba(240, 235, 229, 0.50);
  }
  .sep { opacity: 0.35; }

  h1 {
    font-size: clamp(3.2rem, 7.5vw, 6.4rem);
    line-height: 0.97;
    letter-spacing: -0.04em;
    color: #f0ebe5;
    max-width: 12ch;
  }

  .hero-left .lead {
    color: rgba(240, 235, 229, 0.50);
    max-width: 46ch;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .venn-wrap { display: none; }
  }
</style>
