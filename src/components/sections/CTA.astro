---
// CTA.astro — closing call-to-action, from the HaloBits Landing design.
// Blue background with two aura blobs (blue top-right + orange bottom-left)
// at filter:blur(90px), opacity:.20 — same as the design.
import { content } from '../../i18n/content';
import { localizePath, type Lang } from '../../i18n/utils';

// Optional title/body/button override the default home CTA copy, so the same
// styled accent band can be reused with page-specific wording.
interface Props {
  lang: Lang;
  title?: string;
  body?: string;
  button?: string;
}
const { lang } = Astro.props;
const c = content[lang].cta;
const title = Astro.props.title ?? c.title;
const body = Astro.props.body ?? c.body;
const button = Astro.props.button ?? c.button;
---

<section class="sec-cta">
  <!-- Aura blobs from the design — blue top-right, orange bottom-left -->
  <div class="cta-aura aura-blue" aria-hidden="true"></div>

  <div class="cta-inner">
    <h2>{title}</h2>
    <p class="lead">{body}</p>
    <a href={localizePath('/contact/', lang)} class="btn-white">{button} →</a>
  </div>
</section>

<style>
  .sec-cta {
    /* Starts transparent so the body's deep-blue gradient shows through at the
       top (continuing smoothly from HowWePartner), then brightens into the
       light brand blue. No hard edge, no dark band — pure dark-blue → light-blue. */
    background: linear-gradient(
      to bottom,
      transparent  0%,
      rgba(31,63,195,0.35) 22%,
      rgba(31,63,195,0.75) 42%,
      #1f3fc3 62%,
      #1f3fc3 100%
    );
    position: relative;
    overflow: hidden;
  }

  /* Aura blobs — large blurred circles that add depth to the flat blue */
  .cta-aura {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.20;
    pointer-events: none;
  }
  .aura-blue {
    width: 600px; height: 600px;
    background: #1a60d8;
    top: -180px; right: -120px;
  }
  .aura-orange {
    width: 400px; height: 400px;
    background: #b05820;
    bottom: -120px; left: -80px;
  }

  /* Content sits above the blobs */
  .cta-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(5.5rem, 11vw, 9rem) clamp(1.5rem, 5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
  }

  .sec-cta h2 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-style: italic;
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    color: #fff;
    max-width: 18ch;
    letter-spacing: -0.035em;
    line-height: 1.0;
  }

  .sec-cta .lead {
    color: rgba(255, 255, 255, 0.62);
    max-width: 44ch;
  }

  /* White button on blue — inverted from the main site palette */
  .btn-white {
    display: inline-flex;
    align-items: center;
    padding: 13px 26px;
    border-radius: var(--r-pill);
    font-family: 'Geist', sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    text-decoration: none;
    background: #fff;
    color: var(--accent);
    transition: opacity 0.15s, transform 0.15s;
    white-space: nowrap;
  }
  .btn-white:hover { opacity: 0.92; transform: translateY(-1px); }
</style>
