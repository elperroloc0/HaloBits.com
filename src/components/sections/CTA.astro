---
// CTA.astro — the home page's closing call-to-action on the sunset painting.
// Fades in from black at the top (the band above) and out to black at the
// bottom (the footer below), so there are no hard edges.
import { Image } from 'astro:assets';
import sea from '../../assets/sea-sky.jpg';
import Button from '../ui/Button.astro';
import Fade from '../ui/Fade.astro';
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';
import { primaryCta, smsCta } from '../../lib/cta';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.cta;
const main = primaryCta(lang, 'closing');
const sms = smsCta(lang, 'closing');
---

<section class="cta">
  <Image src={sea} alt={c.alt} class="bg" widths={[800, 1280, 1672]} sizes="100vw" loading="lazy" />
  <div class="top" aria-hidden="true"></div>
  <Fade color="#14110F" height="30%" />
  <div class="wrap in">
    <h2 class="display">{c.title}</h2>
    <p class="body">{c.body}</p>
    <div class="actions">
      <Button href={main.href} size="lg" external={main.external} track={main.track}>{main.label}</Button>
      <Button href={sms.href} size="lg" variant="outline" track={sms.track}>{sms.label}</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    min-height: clamp(640px, 86vh, 940px);
    overflow: hidden;
    display: flex;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% 60%;
  }
  .top {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #14110f 0%,
      rgba(20, 17, 15, 0.55) 22%,
      rgba(20, 17, 15, 0.12) 55%,
      rgba(20, 17, 15, 0) 75%
    );
  }
  .in {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: clamp(110px, 13vw, 190px);
    padding-bottom: 80px;
  }
  h2 {
    font-size: clamp(2.8rem, 6.6vw, 6.4rem);
    line-height: 0.94;
    max-width: 13ch;
    color: var(--cream);
  }
  .body {
    margin-top: 24px;
    max-width: 28rem;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.5;
    color: #f4ede0;
    text-shadow: 0 1px 18px rgba(20, 17, 15, 0.4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
    margin-top: 32px;
  }
</style>
