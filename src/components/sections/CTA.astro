---
// CTA.astro — the home page's closing call-to-action on the sunset painting.
// Fades in from black at the top (the band above) and out to black at the
// bottom (the footer below), so there are no hard edges.
import { Image } from 'astro:assets';
import sea from '../../assets/sea-sky.jpg';
import Fade from '../ui/Fade.astro';
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.cta;
// Last word goes on its own line: "Let's build something" / "together."
const cut = c.title.lastIndexOf(' ');
const line1 = c.title.slice(0, cut);
const line2 = c.title.slice(cut + 1);
---

<section class="cta">
  <Image src={sea} alt={c.alt} class="bg" widths={[800, 1280, 1672]} sizes="100vw" loading="lazy" />
  <div class="top" aria-hidden="true"></div>
  <Fade color="#14110F" height="30%" />
  <div class="wrap in">
    <h2 class="display" data-fit><span>{line1}</span><span>{line2}</span></h2>
  </div>
</section>

<style>
  .cta {
    position: relative;
    min-height: clamp(640px, 86vh, 940px);
    overflow: hidden;
    display: flex;
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 62% 60%;
  }
  .top {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      #14110f 0%,
      rgba(20, 17, 15, 0.55) 22%,
      rgba(20, 17, 15, 0.12) 55%,
      rgba(20, 17, 15, 0) 75%
    );
  }
  .in {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: clamp(110px, 13vw, 190px);
    padding-bottom: 80px;
  }
  h2 {
    font-size: clamp(2.8rem, 6.6vw, 6.4rem);
    line-height: 0.94;
    white-space: nowrap;
    color: var(--cream);
  }
  h2 span {
    display: block;
    width: max-content;
  }
</style>

<script>
  // Stretch the headline's longest line to the full width of its container:
  // measure at a known size, then scale the font so it ends at the right edge.
  function fit() {
    document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const box = el.parentElement;
      if (!box) return;
      const cs = getComputedStyle(box);
      const avail = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      el.style.fontSize = '100px';
      const w = Math.max(...Array.from(el.children, (c) => (c as HTMLElement).offsetWidth));
      if (w > 0 && avail > 0) el.style.fontSize = `${(100 * avail) / w}px`;
    });
  }
  fit();
  document.fonts?.ready.then(fit);
  window.addEventListener('resize', fit);
</script>
