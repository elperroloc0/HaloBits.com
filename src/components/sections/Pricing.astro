---
// Pricing.astro — plain prices on the cream section after "How we partner".
// Numbers live in content.ts (home.pricing). Ends with the same two actions as
// the hero (see lib/cta.ts).
import Button from '../ui/Button.astro';
import { content } from '../../i18n/content';
import { primaryCta, smsCta } from '../../lib/cta';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.pricing;
const main = primaryCta(lang, 'pricing');
const sms = smsCta(lang, 'pricing');
---

<section class="pricing">
  <div class="wrap">
    <h2 class="display">{c.title}</h2>
    <p class="lead">{c.lead}</p>
    <ul class="grid">
      {
        c.items.map((i) => (
          <li>
            <h3>{i.t}</h3>
            <p class="price">{i.p}</p>
            <p class="b">{i.b}</p>
          </li>
        ))
      }
    </ul>
    <p class="foot">{c.foot}</p>
    <div class="actions">
      <Button href={main.href} external={main.external} variant="ink" track={main.track}>{main.label}</Button>
      <Button href={sms.href} variant="outline" class="sms" track={sms.track}>{sms.label}</Button>
    </div>
  </div>
</section>

<style>
  .pricing {
    background: var(--cream);
    color: var(--ink);
    padding: 0 0 clamp(72px, 9vw, 140px);
  }
  h2 {
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }
  .lead {
    margin-top: 20px;
    font-size: 18px;
    color: var(--text-on-cream);
  }
  .grid {
    list-style: none;
    margin: clamp(32px, 4vw, 56px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px clamp(24px, 3vw, 48px);
  }
  li {
    border-top: 1px solid rgba(20, 17, 15, 0.2);
    padding-top: 18px;
  }
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .price {
    margin-top: 8px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.7rem, 2.6vw, 2.3rem);
    letter-spacing: -0.04em;
    color: var(--rust);
  }
  .b {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-on-cream);
  }
  .foot {
    margin-top: 36px;
    max-width: 40rem;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-on-cream);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .actions :global(.sms) {
    color: var(--ink);
    border-color: rgba(20, 17, 15, 0.4);
  }
</style>
