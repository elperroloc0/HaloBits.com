---
// HowWePartner.astro — dark bg with mauve + blue-slate blobs.
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang].howWePartner;
---

<section class="hw-section band band-bg">
  <!-- Grainy blobs: blue right, amber left, faint center -->
  <div class="blob hw1" aria-hidden="true"></div>
  <div class="blob hw2" aria-hidden="true"></div>
  <div class="blob hw3" aria-hidden="true"></div>

  <div class="container" style="position:relative;z-index:1;">
    <div class="s-head">
      <span class="tag">{c.kicker}</span>
      <h2>{c.title}</h2>
    </div>

    <div class="steps-grid">
      {c.steps.map((s) => (
        <div class="step-card">
          <div class="step-n">{s.n}</div>
          <div class="step-title">{s.title}</div>
          <div class="step-body">{s.body}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hw-section { overflow: hidden; }

  /* Only a top fade (blends from WhatWeBuild above). No bottom overlay —
     the bottom just flows with the body's blue gradient, and the CTA section
     below handles the whole dark-blue → light-blue transition itself. */
  .hw-section::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 140px;
    pointer-events: none;
    z-index: 0;
    background: linear-gradient(to bottom, rgba(12,11,10,0.70), transparent);
  }

  .hw1 {
    width: 660px; height: 660px;
    right: -160px; top: 0;
    background: radial-gradient(circle, oklch(0.64 0.12 258 / .24), transparent 70%);
    filter: blur(90px); z-index: 0;
  }
  .hw2 {
    width: 460px; height: 460px;
    left: -80px; bottom: 0;
    background: radial-gradient(circle, oklch(0.62 0.13 42 / .20), transparent 70%);
    filter: blur(75px); z-index: 0;
  }
  .hw3 {
    width: 360px; height: 360px;
    left: 42%; top: 25%;
    background: radial-gradient(circle, oklch(0.50 0.09 335 / .14), transparent 70%);
    filter: blur(80px); z-index: 0;
  }

  .s-head {
    max-width: 640px;
    display: flex; flex-direction: column; gap: 16px;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  /* 3-column grid with hairline separators */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r);
    overflow: hidden;
  }
  .step-card {
    padding: 34px 30px;
    background: rgba(12, 11, 10, 0.55);
    backdrop-filter: blur(14px);
  }
  /* Numbered badge — blue square pill */
  .step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px; height: 52px;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: #fff;
    background: var(--accent);
    border-radius: 14px;
    margin-bottom: 20px;
    box-shadow: 0 4px 20px oklch(0.64 0.12 258 / .35);
  }
  .step-title {
    font-weight: 600; margin-bottom: 10px; color: var(--fg);
  }
  .step-body { font-size: 14px; color: var(--muted); line-height: 1.65; }

  @media (max-width: 820px) {
    .steps-grid { grid-template-columns: 1fr; }
  }
</style>
