---
// HowWePartner.astro — "We stay after launch." A cream timeline:
//   Discovery → Build (hollow nodes, equal width) → Run it together (an orange
//   orb that takes the rest of the row, with a glowing line that fades off the
//   right edge of the screen, month ticks M1–M12 and a dot travelling along it).
// Desktop (≥900px) is horizontal; phones get a vertical version. Both are in the
// HTML and CSS shows one — `display:none` also hides it from screen readers.
import { content } from '../../i18n/content';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.partner;

const steps = [
  { cap: c.s1c, title: c.s1t, body: c.s1b },
  { cap: c.s2c, title: c.s2t, body: c.s2b },
];
const months = Array.from({ length: 12 }, (_, i) => `${c.m}${i + 1}`);
const monthsShort = Array.from({ length: 8 }, (_, i) => `${c.month} ${i + 1}`);
---

<section class="partner">
  <div class="wrap">
    <div class="head">
      <h2 class="display">{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <!-- ── Desktop: horizontal ───────────────────────────────────────────── -->
    <div class="tl-d">
      {
        steps.map((s) => (
          <div class="step">
            <div class="track">
              <div class="line" />
              <span class="node" />
            </div>
            <p class="eyebrow cap first">{s.cap}</p>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
          </div>
        ))
      }
      <div class="step main">
        <div class="track">
          <div class="line line--run" />
          <span class="orb" />
          <div class="travel" aria-hidden="true"><span class="dot"></span></div>
        </div>
        <div class="ticks" aria-hidden="true">
          {
            months.map((m) => (
              <span class="tick">
                <span class="stem" />
                {m}
              </span>
            ))
          }
        </div>
        <div class="run-copy">
          <p class="eyebrow cap">{c.s3c}</p>
          <h3>{c.s3t}</h3>
          <p class="body">{c.s3b}</p>
        </div>
      </div>
    </div>

    <!-- ── Mobile: vertical ──────────────────────────────────────────────── -->
    <div class="tl-m">
      {
        steps.map((s) => (
          <div class="mstep">
            <div class="mtrack">
              <div class="mline" />
              <span class="node mnode" />
            </div>
            <div class="mcopy">
              <p class="eyebrow cap">{s.cap}</p>
              <h3>{s.title}</h3>
              <p class="body">{s.body}</p>
            </div>
          </div>
        ))
      }
      <div class="mstep">
        <div class="mtrack">
          <div class="mline mline--run" />
          <span class="orb morb" />
        </div>
        <div class="mcopy last">
          <p class="eyebrow cap">{c.s3c}</p>
          <h3>{c.s3t}</h3>
          <p class="body">{c.s3b}</p>
          <div class="mticks" aria-hidden="true">
            {monthsShort.map((m) => <span>{m}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .partner {
    background: var(--cream);
    color: var(--ink);
    padding: clamp(40px, 6vw, 90px) 0 clamp(60px, 8vw, 120px);
    overflow: hidden;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px clamp(32px, 6vw, 96px);
  }
  h2 {
    flex: 6 1 460px;
    font-size: clamp(2.6rem, 6.2vw, 5.8rem);
    max-width: 11ch;
  }
  .lead {
    flex: 4 1 300px;
    max-width: 30rem;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--text-on-cream);
  }

  .cap {
    color: var(--rust);
  }
  h3 {
    margin-top: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
  }
  .body {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-on-cream);
    text-wrap: pretty;
  }

  /* Shared node styles (hollow circle / orange orb) */
  .node {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: var(--cream);
  }
  .orb {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #f6c453, #e8642c 60%, #b8431a);
    box-shadow: 0 0 0 6px var(--cream), 0 0 0 7.5px rgba(232, 100, 44, 0.55);
  }

  /* ── Desktop ── */
  .tl-d {
    margin-top: clamp(72px, 8vw, 120px);
    display: flex;
    /* let the glowing line run off the right edge of the viewport */
    margin-right: calc(-1 * var(--gutter) - max(0px, (100vw - var(--maxw)) / 2));
  }
  .tl-m {
    display: none;
  }
  .step {
    flex: 0 0 24%;
    padding-right: 32px;
  }
  .step.main {
    flex: 1 1 auto;
    min-width: 0;
    padding-right: 0;
  }
  .track {
    position: relative;
    height: 28px;
    display: flex;
    align-items: center;
  }
  .line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: var(--ink);
    opacity: 0.28;
  }
  .line--run {
    height: 3px;
    margin-top: -1px;
    opacity: 1;
    background: linear-gradient(90deg, #e8642c 0%, #f3a15f 55%, rgba(243, 161, 95, 0) 100%);
  }
  /* All three captions sit on one baseline: 47px under the track. */
  .cap.first {
    margin-top: 47px;
  }
  .travel {
    position: absolute;
    left: 60px;
    right: 0;
    top: 0;
    bottom: 0;
  }
  .dot {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 4px rgba(232, 100, 44, 0.18);
    animation: hb-travel 9s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .dot {
      left: 12%;
    }
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    height: 37px;
    padding: 10px 0 0 56px;
    -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent);
    mask-image: linear-gradient(90deg, #000 55%, transparent);
  }
  .tick {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--text-on-cream-2);
  }
  .stem {
    width: 1.5px;
    height: 8px;
    background: var(--rust);
    opacity: 0.6;
  }
  .run-copy {
    max-width: 28rem;
  }
  .run-copy .cap {
    margin-top: 10px;
  }

  /* ── Mobile ── */
  .mstep {
    display: flex;
    gap: 20px;
  }
  .mtrack {
    position: relative;
    flex: 0 0 26px;
    display: flex;
    justify-content: center;
  }
  .mline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: var(--ink);
    opacity: 0.28;
  }
  .mline--run {
    width: 3px;
    opacity: 1;
    background: linear-gradient(180deg, #e8642c, #f3a15f 70%, rgba(243, 161, 95, 0));
  }
  .mnode {
    margin-top: 3px;
  }
  .morb {
    width: 24px;
    height: 24px;
    box-shadow: 0 0 0 5px var(--cream), 0 0 0 6.5px rgba(232, 100, 44, 0.55);
  }
  .mcopy {
    padding-bottom: 44px;
  }
  .mcopy.last {
    padding-bottom: 28px;
  }
  .mcopy .cap {
    margin: 0;
  }
  .mcopy h3 {
    margin-top: 8px;
    font-size: 1.75rem;
  }
  .mcopy .body {
    margin-top: 10px;
  }
  .mticks {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--text-on-cream-2);
    -webkit-mask-image: linear-gradient(90deg, #000 50%, transparent);
    mask-image: linear-gradient(90deg, #000 50%, transparent);
  }

  @media (max-width: 899px) {
    .tl-d {
      display: none;
    }
    .tl-m {
      margin-top: 64px;
      display: flex;
      flex-direction: column;
    }
  }
</style>
