---
// WhatWeBuild.astro — the home page's product INDEX (dark): three big text rows,
// no cards. The name turns butter on hover; each row links to its anchor on the
// What we build page.
import Button from '../ui/Button.astro';
import { content } from '../../i18n/content';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = content[lang].home.build;
---

<section class="build">
  <div class="wrap">
    <div class="head">
      <h2 class="display">{c.title}</h2>
      <Button href={localizePath('/what-we-build/', lang)} track="cta_build_index">{c.all}</Button>
    </div>

    <div class="rows">
      {
        c.items.map((p) => (
          <a href={localizePath(p.href, lang)} class="row">
            <span class="name">{p.name}</span>
            <span class="meta">
              <span class="for">{p.for}</span>
              <span class="line">{p.line}</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="note">{c.note}</p>
  </div>
</section>

<style>
  .build {
    background: var(--ink);
    color: var(--cream);
    padding: clamp(64px, 8vw, 120px) 0 clamp(60px, 8vw, 120px);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }
  h2 {
    font-size: clamp(2.2rem, 4.6vw, 4.3rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 17ch;
  }
  .rows {
    margin-top: clamp(56px, 7vw, 100px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  /* Two fixed columns (name | description) so every description starts on the
     same vertical line, whatever the name's width. Stacks on phones. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: baseline;
    gap: 10px clamp(24px, 4vw, 64px);
    text-decoration: none;
    color: var(--cream);
  }
  @media (max-width: 799px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .row:hover {
    color: var(--butter);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 4.4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 34rem;
  }
  .for {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--apricot);
  }
  .line {
    font-size: 17px;
    line-height: 1.5;
    color: var(--soft);
  }
  .note {
    margin-top: clamp(64px, 8vw, 110px);
    max-width: 40rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
