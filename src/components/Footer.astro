---
// Footer.astro — plain warm-black footer with a touch of film grain. No image:
// the eased gradient band above each page melts into this colour. No tagline,
// no language switch, no product URL here.
import { localizePath, useTranslations, type Lang } from '../i18n/utils';
import { SITE, telHref } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { to: '/what-we-build/', label: t.nav.whatWeBuild },
  { to: '/about/', label: t.nav.about },
  { to: '/faq/', label: t.nav.faq },
  { to: '/contact/', label: t.nav.contact },
];
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="grain" aria-hidden="true"></div>

  <div class="inner">
    <!-- One horizontal line: wordmark · page links · contact. Wraps on phones. -->
    <div class="row">
      <p class="mark">HaloBits</p>
      <nav class="col links" aria-label={t.nav.label}>
        {links.map((l) => <a href={localizePath(l.to, lang)}>{l.label}</a>)}
      </nav>
      <div class="col contact">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={telHref}>{SITE.phoneDisplay}</a>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {t.footer.rights}</span>
      <nav class="legal-links" aria-label={t.footer.privacy + ' / ' + t.footer.terms}>
        <a href={localizePath('/privacy/', lang)}>{t.footer.privacy}</a>
        <a href={localizePath('/terms/', lang)}>{t.footer.terms}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    overflow: hidden;
  }
  .grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 200px 200px;
    opacity: 0.32;
    mix-blend-mode: overlay;
  }
  .inner {
    position: relative;
    z-index: 2;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(56px, 6vw, 88px) var(--gutter) 28px;
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 4vw, 48px);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px clamp(32px, 5vw, 80px);
  }
  .col {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(20px, 2.4vw, 36px);
    font-size: 15px;
  }
  .col a {
    text-decoration: none;
    padding: 12px 0;
  }
  .legal {
    margin-top: clamp(40px, 5vw, 72px);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .legal-links {
    display: flex;
    gap: 24px;
  }
  .legal-links a {
    padding: 12px 0;
    text-decoration: none;
  }
  .legal-links a:hover {
    color: var(--cream);
  }
</style>
