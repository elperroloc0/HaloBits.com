---
// Nav.astro — fixed top bar.
//   • Over image heroes (Home, About, Contact) it starts transparent.
//   • On "flow" pages (What we build, FAQ, 404) it starts solid and a spacer
//     reserves its height, because those pages have no hero to sit on top of.
//   • After scrolling 40px it gets a near-solid background and tightens up.
//   • Below 900px the links collapse into a full-screen "Menu" dialog.
// `tone` flips the colours for cream pages (FAQ). The only JS is the small
// <script> at the bottom: scroll state + opening/closing the menu.
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizePath, useTranslations, type Lang } from '../i18n/utils';

export type NavKey = 'home' | 'build' | 'about' | 'faq' | 'contact';

interface Props {
  lang: Lang;
  current?: NavKey;
  tone?: 'dark' | 'light';
  flow?: boolean;
}
const { lang, current, tone = 'dark', flow = false } = Astro.props;
const t = useTranslations(lang);

const links: Array<{ key: NavKey; to: string; label: string }> = [
  { key: 'build', to: '/what-we-build/', label: t.nav.whatWeBuild },
  { key: 'about', to: '/about/', label: t.nav.about },
  { key: 'faq', to: '/faq/', label: t.nav.faq },
  { key: 'contact', to: '/contact/', label: t.nav.contact },
];
const home = localizePath('/', lang);
const talk = localizePath('/contact/', lang);
---

{flow && <div class="spacer" aria-hidden="true" />}
<header class="nav" id="site-nav" data-tone={tone} data-flow={flow ? 'true' : 'false'}>
  <nav class="bar" aria-label={t.nav.label}>
    <a href={home} class="brand">HaloBits</a>

    <div class="links">
      {
        links.map((l) => (
          <a
            href={localizePath(l.to, lang)}
            class:list={['link', { current: current === l.key }]}
            aria-current={current === l.key ? 'page' : undefined}
          >
            {l.label}
            <span class="dot" aria-hidden="true" />
          </a>
        ))
      }
    </div>

    <div class="right">
      <LanguageSwitcher />
      <a href={talk} class="talk">{t.nav.talk}</a>
      <button
        type="button"
        class="menu-btn"
        id="menu-open"
        aria-expanded="false"
        aria-controls="hb-menu">{t.nav.menu}</button
      >
    </div>
  </nav>

  <div id="hb-menu" class="menu" role="dialog" aria-modal="true" aria-label={t.nav.menu} hidden>
    <div class="menu-top">
      <span class="menu-brand">HaloBits</span>
      <button type="button" class="menu-close" id="menu-close">{t.nav.close}</button>
    </div>
    <div class="menu-links">
      <a href={home}>{t.nav.home}</a>
      {links.map((l) => <a href={localizePath(l.to, lang)} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}
    </div>
    <a href={talk} class="menu-talk">{t.nav.talk}</a>
  </div>
</header>

<style>
  .spacer {
    height: 80px;
  }
  .nav {
    --nav-fg: #efe6d6;
    --nav-muted: rgba(239, 230, 214, 0.78);
    --nav-faint: rgba(239, 230, 214, 0.35);
    --nav-border: rgba(239, 230, 214, 0.42);
    --nav-inv: #14110f;
    --nav-solid: #14110f;
    --nav-scrolled: rgba(20, 17, 15, 0.96);
    --nav-hairline: rgba(239, 230, 214, 0.06);

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background: transparent;
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }
  .nav[data-tone='light'] {
    --nav-fg: #14110f;
    --nav-muted: rgba(20, 17, 15, 0.62);
    --nav-faint: rgba(20, 17, 15, 0.3);
    --nav-border: rgba(20, 17, 15, 0.35);
    --nav-inv: #efe6d6;
    --nav-solid: #efe6d6;
    --nav-scrolled: rgba(239, 230, 214, 0.97);
    --nav-hairline: rgba(20, 17, 15, 0.08);
  }
  .nav[data-flow='true'] {
    background: var(--nav-solid);
  }
  .nav[data-scrolled='true'] {
    background: var(--nav-scrolled);
    box-shadow: 0 1px 0 var(--nav-hairline);
  }

  .bar {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 18px var(--gutter);
    transition: padding 0.35s ease;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  [data-scrolled='true'] .bar {
    padding-block: 8px;
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    color: var(--nav-fg);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .brand:hover {
    color: var(--nav-fg);
  }

  .links {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 36px);
    font-size: 14.5px;
  }
  .link {
    position: relative;
    padding: 12px 0;
    text-decoration: none;
    color: var(--nav-muted);
  }
  .link:hover,
  .link.current {
    color: var(--nav-fg);
  }
  .dot {
    position: absolute;
    left: 50%;
    bottom: 4px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--nav-fg);
    opacity: 0;
  }
  .current .dot {
    opacity: 1;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .talk {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    white-space: nowrap;
    text-decoration: none;
    color: var(--nav-fg);
    font-size: 14.5px;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }
  .talk:hover {
    background: var(--nav-fg);
    color: var(--nav-inv);
  }
  .menu-btn {
    display: none;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1px solid var(--nav-border);
    background: transparent;
    color: var(--nav-fg);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: var(--cursor-hand);
  }

  /* --- Full-screen mobile menu (always dark) --- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: #14110f;
    color: #efe6d6;
    display: flex;
    flex-direction: column;
    padding: 18px 20px 32px;
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
  }
  .menu-brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.035em;
  }
  .menu-close {
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(239, 230, 214, 0.4);
    background: none;
    color: #efe6d6;
    font: inherit;
    font-size: 14px;
    cursor: var(--cursor-hand);
  }
  .menu-links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 48px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 40px;
    letter-spacing: -0.03em;
  }
  .menu-links a {
    text-decoration: none;
    padding: 8px 0;
    color: #efe6d6;
  }
  .menu-talk {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    border-radius: 999px;
    background: #efe6d6;
    color: #14110f;
    text-decoration: none;
    font-weight: 600;
    font-size: 17px;
  }
  .menu-talk:hover {
    color: #14110f;
  }

  /* Mobile breakpoint from the handoff: < 900px */
  @media (max-width: 899px) {
    .links,
    .talk {
      display: none;
    }
    .menu-btn {
      display: inline-block;
    }
  }
</style>

<script>
  // Runs once per page load (no client router, so no re-init needed).
  const nav = document.getElementById('site-nav');
  const menu = document.getElementById('hb-menu');
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');

  // 1. Scrolled state — drives the tighter, more opaque bar.
  const onScroll = () => nav?.setAttribute('data-scrolled', String(window.scrollY > 40));
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 2. Mobile menu.
  const setMenu = (open: boolean) => {
    if (!menu || !openBtn) return;
    menu.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener('click', () => setMenu(true));
  closeBtn?.addEventListener('click', () => setMenu(false));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) setMenu(false);
  });
  // Growing the window past the breakpoint while the menu is open would leave
  // it stuck on screen with the page locked.
  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches && menu && !menu.hidden) setMenu(false);
  });
</script>
