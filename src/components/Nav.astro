---
// Nav.astro — sticky top navigation, localized, dark theme.
// Background is near-black transparent matching the hero — no more
// light warm stripe appearing as a "blur layer" over the dark hero.
// The `scrolled` class is toggled by a small inline script (the only JS
// we ship) to deepen the background and show a gradient border on scroll.
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getBasePath, localizePath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const base = getBasePath(Astro.url);
const links = [
  { to: '/what-we-build/', label: t.nav.whatWeBuild },
  { to: '/about/', label: t.nav.about },
  { to: '/contact/', label: t.nav.contact },
];
---

<header class="nav" id="main-nav">
  <div class="nav-inner">
    <a href={localizePath('/', lang)} class="brand">
      <span class="brand-mark">✦</span>
      <span class="brand-name">HaloBits</span>
    </a>

    <!-- separator -->
    <span class="nav-sep" aria-hidden="true"></span>

    <nav class="nav-links">
      {links.map((l) => (
        <a href={localizePath(l.to, lang)} class:list={['nav-lnk', { active: base === l.to }]}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="nav-r">
      <LanguageSwitcher />
      <a href={localizePath('/contact/', lang)} class="nav-cta">
        {lang === 'es' ? 'Hablemos →' : "Let's talk →"}
      </a>
    </div>
  </div>
</header>

<!-- Minimal inline script: adds .scrolled to deepen the nav background
     once the user scrolls past 40px. No external file, tiny footprint. -->
<script>
  const nav = document.getElementById('main-nav');
  function tick() { nav?.classList.toggle('scrolled', window.scrollY > 40); }
  window.addEventListener('scroll', tick, { passive: true });
  tick();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Dark transparent — blends with the dark hero, doesn't create a
       bright "stripe" layer over the dark background. */
    background: rgba(12, 11, 10, 0.76);
    backdrop-filter: blur(32px) saturate(200%) brightness(1.05);
    -webkit-backdrop-filter: blur(32px) saturate(200%) brightness(1.05);
    /* Subtle inner highlight at the top */
    box-shadow: inset 0 1px 0 rgba(240, 235, 229, 0.06);
    border-bottom: 1px solid transparent;
    /* Gradient border line appears after scrolling (via .scrolled) */
    transition: background 0.3s, box-shadow 0.3s;
  }

  /* Gradient underline — becomes visible once you scroll past the hero */
  .nav::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 0; right: 0; height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(240,235,229,.08) 15%,
      oklch(0.64 0.12 258 / .25) 45%,
      oklch(0.62 0.13 42 / .14) 70%,
      rgba(240,235,229,.04) 88%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.35s;
  }

  .nav.scrolled {
    background: rgba(12, 11, 10, 0.92);
    box-shadow: 0 4px 32px rgba(0,0,0,.38), inset 0 1px 0 rgba(240,235,229,.08);
  }
  .nav.scrolled::after { opacity: 1; }

  .nav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 5vw, 2.5rem);
    height: 60px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* Brand */
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-mark {
    /* Glowing ✦ — brand motif */
    color: var(--pw);
    font-size: 15px;
    text-shadow: 0 0 14px oklch(0.64 0.12 258 / .65);
    transition: text-shadow 0.35s;
  }
  .brand:hover .brand-mark { text-shadow: 0 0 22px oklch(0.64 0.12 258 / .95); }
  .brand-name {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.03em;
    color: #f0ebe5;
  }

  /* Separator */
  .nav-sep {
    width: 1px; height: 18px;
    background: rgba(240, 235, 229, 0.10);
    margin: 0 14px;
    flex-shrink: 0;
  }

  /* Nav links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1px;
    flex: 1;
  }
  .nav-lnk {
    font-size: 13.5px;
    font-weight: 500;
    color: rgba(240, 235, 229, 0.50);
    text-decoration: none;
    padding: 7px 12px;
    border-radius: var(--r-pill);
    transition: color 0.15s, background 0.15s;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav-lnk:hover { color: #f0ebe5; background: rgba(240, 235, 229, 0.08); }
  .nav-lnk.active { color: #f0ebe5; background: rgba(240, 235, 229, 0.07); }

  /* Right cluster */
  .nav-r {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* CTA pill button */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    background: #f0ebe5;
    color: #0c0b0a;
    font-family: 'Geist', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s, transform 0.15s;
  }
  .nav-cta:hover { opacity: 0.87; transform: translateY(-1px); }

  @media (max-width: 860px) { .nav-links { display: none; } .nav-sep { display: none; } }
  @media (max-width: 600px) { .nav-cta { display: none; } }
</style>
