---
// LanguageSwitcher.astro — EN / ES toggle. Just two links (no JavaScript): each
// points at the CURRENT page's twin in the other language, computed by
// getAlternateUrls. On /about/ it links to /es/about/, and vice-versa.
import { getAlternateUrls, getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const alt = getAlternateUrls(Astro.url);
const t = useTranslations(lang);
---

<div class="lang" role="group" aria-label={t.langSwitch.label}>
  <a
    href={alt.en}
    hreflang="en"
    lang="en"
    class:list={['lang-link', { active: lang === 'en' }]}
    aria-current={lang === 'en' ? 'true' : undefined}>EN</a
  >
  <span class="sep" aria-hidden="true">/</span>
  <a
    href={alt.es}
    hreflang="es"
    lang="es"
    class:list={['lang-link', { active: lang === 'es' }]}
    aria-current={lang === 'es' ? 'true' : undefined}>ES</a
  >
</div>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lang-link {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(240, 235, 229, 0.40);
    padding: 2px 2px;
    text-decoration: none;
    transition: color 0.15s;
  }
  .lang-link:hover { color: #f0ebe5; }
  .lang-link.active { color: #f0ebe5; }
  .sep {
    color: rgba(240, 235, 229, 0.20);
    font-size: 12px;
  }
</style>
