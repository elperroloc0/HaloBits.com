---
// src/pages/404.astro — the reserved not-found page (Astro → 404.html, served by
// Vercel for any unknown URL). A 404 is a single file, so it can't be per-locale
// by route; we render it in English (the default) but reuse the same layout and
// design system so it still feels like the site.
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { content } from '../i18n/content';
import { localizePath } from '../i18n/utils';

const lang = 'en';
const c = content[lang].notFound;
const meta = content[lang].meta.notFound;
---

<Base lang={lang} title={meta.title} description={meta.description} flow noindex>
  <section class="notfound">
    <div class="wrap">
      <p class="eyebrow code">404</p>
      <h1 class="display">{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <div class="cta">
        <Button href={localizePath('/', lang)}>{c.home}</Button>
        <Button href={localizePath('/what-we-build/', lang)} variant="outline">{c.build}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound {
    padding: clamp(72px, 10vw, 150px) 0 clamp(96px, 12vw, 180px);
  }
  .code {
    color: var(--apricot);
    margin-bottom: 18px;
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 6.8rem);
    max-width: 12ch;
  }
  .lead {
    margin-top: 24px;
    max-width: 30rem;
    font-size: clamp(17px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--soft);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
